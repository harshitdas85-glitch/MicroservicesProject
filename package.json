{
  "name": "microservicesproject",
  "version": "1.0.0",
  "private": "true",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:auth": "npm run dev -w auth-service",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "dev:api": "npm run dev -w api-gateway",
    "dev:task": "npm run dev -w task-service",
    "dev:media": "npm run dev -w media-service",
    "kafka:up" : "docker compose -f docker/docker-compose.yml up -d",
     "kafka:down" : "docker compose -f docker/docker-compose.yml down",
     "kafka:logs" : "docker compose -f doker/docker-compose.yml logs -f kafka",
     "dev:workflow"  : "npm run dev -w workflow-service"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4"
  }
}
